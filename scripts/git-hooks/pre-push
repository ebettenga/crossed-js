#!/usr/bin/env bash
# Rebuilds and republishes Crossed.apk when a push to main touches frontend/.
# Skip with SKIP_APK_BUILD=1 git push
set -euo pipefail

if [ "${SKIP_APK_BUILD:-}" = "1" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"
needs_build=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" != "$ZERO" ] || continue

  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")"
  else
    base="$remote_sha"
  fi

  if [ -z "$base" ] || ! git diff --quiet "$base" "$local_sha" -- frontend/; then
    needs_build=1
  fi
done

if [ "$needs_build" = "1" ]; then
  "$ROOT/scripts/build-android-apk.sh" || {
    echo "Push blocked: APK build failed. Retry with SKIP_APK_BUILD=1 git push to push anyway." >&2
    exit 1
  }
fi
